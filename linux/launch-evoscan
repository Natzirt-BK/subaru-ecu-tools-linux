#!/bin/sh
set -eu

: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${ECU_TOOLS_DATA_DIR:=$XDG_DATA_HOME/subaru-ecu-tools-linux}"
: "${EVOSCAN_WINEPREFIX:=$XDG_DATA_HOME/ecuflash-proton}"

if [ -z "${EVOSCAN_WINE:-}" ]; then
    project_wine="$ECU_TOOLS_DATA_DIR/runtime/ecuflash-winegdk-11.1/files/bin/wine"
    if [ -x "$project_wine" ]; then
        EVOSCAN_WINE=$project_wine
    else
        EVOSCAN_WINE=wine
    fi
fi

report_error() {
    printf '%s\n' "$1" >&2
    if command -v kdialog >/dev/null 2>&1 && \
       { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        kdialog --title "EvoScan could not start" --error "$1" || true
    fi
}

if ! command -v "$EVOSCAN_WINE" >/dev/null 2>&1 && [ ! -x "$EVOSCAN_WINE" ]; then
    report_error "The configured EvoScan Wine runner is missing: $EVOSCAN_WINE. Open Setup from the Subaru & Evo ECU Tools menu."
    exit 1
fi

if [ -z "${EVOSCAN_EXE:-}" ]; then
    if [ -f "$ECU_TOOLS_DATA_DIR/evoscan-exe.path" ]; then
        IFS= read -r EVOSCAN_EXE <"$ECU_TOOLS_DATA_DIR/evoscan-exe.path" || EVOSCAN_EXE=
    fi
fi
if [ -z "${EVOSCAN_EXE:-}" ]; then
    for candidate in \
        "$EVOSCAN_WINEPREFIX/drive_c/EvoScan/EvoScan.exe" \
        "$EVOSCAN_WINEPREFIX/drive_c/EvoScan/EvoScanV3.exe" \
        "$EVOSCAN_WINEPREFIX/drive_c/Program Files/EvoScan/EvoScan.exe" \
        "$EVOSCAN_WINEPREFIX/drive_c/Program Files (x86)/EvoScan/EvoScan.exe"; do
        if [ -f "$candidate" ]; then
            EVOSCAN_EXE=$candidate
            break
        fi
    done
fi
if [ -z "${EVOSCAN_EXE:-}" ] || [ ! -f "$EVOSCAN_EXE" ]; then
    report_error "EvoScan is not installed in the shared EcuFlash Wine prefix. Re-run setup and select your purchased EvoScan installer."
    exit 1
fi

log_dir="$XDG_STATE_HOME/subaru-ecu-tools-linux"
log_file="$log_dir/evoscan-launch.log"
mkdir -p "$log_dir"
if [ -f "$log_file" ] && [ "$(wc -c <"$log_file")" -gt 10485760 ]; then
    mv -f -- "$log_file" "$log_file.previous"
fi

export WINEPREFIX="$EVOSCAN_WINEPREFIX"
export WINEDLLPATH="$ECU_TOOLS_DATA_DIR/winedll${WINEDLLPATH:+:$WINEDLLPATH}"
cd "$(dirname -- "$EVOSCAN_EXE")"
set +e
"$EVOSCAN_WINE" "$EVOSCAN_EXE" "$@" >>"$log_file" 2>&1
status=$?
set -e
if [ "$status" -ne 0 ]; then
    report_error "EvoScan exited with status $status. Diagnostic log: $log_file"
fi
exit "$status"
