#!/bin/sh
set -eu

: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${EVO_MUT2_HOME:=$XDG_DATA_HOME/romraider-mut2-evo-88780008}"
: "${EVO_MUT2_MODE:=logger}"
: "${OPENPORT_USB_SYSFS_ROOT:=/sys/bus/usb/devices}"
: "${OPENPORT_USB_DEV_ROOT:=/dev/bus/usb}"

report_error() {
    printf '%s\n' "$1" >&2
    if command -v kdialog >/dev/null 2>&1 && \
       { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        kdialog --title "MUT-Raider-II could not start" --error "$1" || true
    fi
}

openport_accessible_or_absent() {
    found=false
    for vendor_file in "$OPENPORT_USB_SYSFS_ROOT"/*/idVendor; do
        [ -f "$vendor_file" ] || continue
        [ "$(tr '[:upper:]' '[:lower:]' <"$vendor_file")" = 0403 ] || continue
        device_dir=${vendor_file%/idVendor}
        [ -f "$device_dir/idProduct" ] || continue
        [ "$(tr '[:upper:]' '[:lower:]' <"$device_dir/idProduct")" = cc4d ] || continue
        found=true
        read -r busnum <"$device_dir/busnum" || continue
        read -r devnum <"$device_dir/devnum" || continue
        case "$busnum:$devnum" in *[!0-9:]*|:|*:|*:*:*) continue ;; esac
        node=$(printf '%s/%03d/%03d' "$OPENPORT_USB_DEV_ROOT" "$busnum" "$devnum")
        [ -r "$node" ] && [ -w "$node" ] && return 0
    done
    ! $found
}

if [ ! -f "$EVO_MUT2_HOME/.installed-by-subaru-ecu-tools" ]; then
    report_error "The optional Evo MUT-Raider-II package is not installed. Open Subaru & Evo ECU Tools Setup and select Optional Evo MUT-Raider-II."
    exit 1
fi
if [ "$EVO_MUT2_MODE" = logger ] && ! openport_accessible_or_absent; then
    report_error "The connected OpenPort is not readable and writable. Open Setup, repair USB permissions, then reconnect it."
    exit 1
fi

case "$EVO_MUT2_MODE" in
    logger) launcher=$EVO_MUT2_HOME/START_LOGGER_LINUX.sh ;;
    editor) launcher=$EVO_MUT2_HOME/START_EDITOR_LINUX.sh ;;
    *) report_error "EVO_MUT2_MODE must be logger or editor."; exit 2 ;;
esac
if [ ! -x "$launcher" ]; then
    report_error "The Evo RomRaider launcher is missing: $launcher. Reinstall the optional component."
    exit 1
fi

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/subaru-ecu-tools-linux
mkdir -p "$state_dir"
log=$state_dir/evo-mut2-launch.log
set +e
"$launcher" >>"$log" 2>&1
status=$?
set -e
if [ "$status" -ne 0 ]; then
    report_error "MUT-Raider-II exited with status $status. Diagnostic log: $log"
fi
exit "$status"
