#!/usr/bin/env bash
set -euo pipefail

data_root=${XDG_DATA_HOME:-$HOME/.local/share}
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/subaru-ecu-tools-linux
install_root=${ROMRAIDER2_INSTALL_ROOT:-$data_root/romraider2-ecu-studio}
archive=${ROMRAIDER2_ARCHIVE:-$cache_root/RomRaider2_ECU_Studio_1.1.10_Linux_x64.zip}
archive_root=RomRaider2_ECU_Studio_1.1.10_Linux_x64
release_url=${ROMRAIDER2_URL:-https://github.com/Natzirt-BK/RomRaider2/releases/download/romraider2-1.1.10/RomRaider2_ECU_Studio_1.1.10_Linux_x64.zip}
release_sha256=${ROMRAIDER2_SHA256:-253167764d1fa44ab85c8abb740444fdb3fb44ea265f70ae7e9778a26bff98b4}
source_root=${ROMRAIDER2_SOURCE_ROOT:-}
quiet=${ROMRAIDER2_QUIET:-0}
if [[ -n "${ROMRAIDER2_LEGACY_INSTALL_ROOT:-}" ]]; then
    legacy_install_roots=("$ROMRAIDER2_LEGACY_INSTALL_ROOT")
else
    legacy_install_roots=(
        "$data_root/bergerraider-ecu-studio"
        "$data_root/bergerraider-ecu-studio-preview-1"
    )
fi

notice() {
    [[ "$quiet" == 1 ]] || printf '%s\n' "$*"
}

case "$install_root" in
    ''|/|"$HOME") echo "Unsafe RomRaider2 install path: $install_root" >&2; exit 2 ;;
esac
[[ ! -L "$install_root" ]] || {
    echo 'Refusing to replace a symlinked installation; the existing path is unchanged.' >&2
    exit 2
}

modern_install() {
    local root=$1
    [[ -x "$root/bin/RomRaider2" && \
       -f "$root/lib/runtime/release" && \
       -f "$root/lib/app/RomRaider2.jar" && \
       -f "$root/lib/app/RomRaider2.cfg" && \
       -f "$root/lib/app/lib/linux/64/j2534.so" && \
       -f "$root/config/settings.default.xml" && \
       -f "$root/VERSION.txt" && \
       -f "$root/customize/j2534Libraries.properties" ]] && \
        grep -Fxq 'RomRaider2 ECU Studio 1.1.10' \
            "$root/VERSION.txt" && \
        grep -Fq 'romraider2.settings.dir=$APPDIR/../../config/user' \
            "$root/lib/app/RomRaider2.cfg" && \
        ! grep -Eq 'ecudefinitionfile|<definition |<profile ' \
            "$root/config/settings.default.xml" && \
        grep -Fq 'linux=j2534.so' \
            "$root/customize/j2534Libraries.properties"
}

if modern_install "$install_root" && \
   [[ -f "$install_root/.installed-by-subaru-ecu-tools" ]] && \
   [[ -f "$install_root/.release-sha256" ]] && \
   grep -Fxq "$release_sha256" "$install_root/.release-sha256"; then
    notice "  OK RomRaider2 1.1.10 is already current."
    exit 0
fi

mkdir -p "$cache_root" "$(dirname -- "$install_root")"
stage=$(mktemp -d "$(dirname -- "$install_root")/.romraider2-install.XXXXXX")
backup=
installation_committed=false
cleanup() {
    local status=$?
    trap - EXIT HUP INT TERM
    if ! $installation_committed && [[ -n "$backup" && -d "$backup" && \
            ! -e "$install_root" && ! -L "$install_root" ]]; then
        if mv -- "$backup" "$install_root"; then
            echo 'Restored the previous installation after an incomplete update.' >&2
        else
            echo "The previous installation is preserved at: $backup" >&2
        fi
    fi
    rm -rf -- "$stage"
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ -n "$source_root" ]]; then
    [[ -d "$source_root" ]] || {
        echo "ROMRAIDER2_SOURCE_ROOT is not a directory: $source_root" >&2
        exit 2
    }
    cp -a -- "$source_root" "$stage/$archive_root"
else
    if [[ ! -f "$archive" ]] || \
       ! printf '%s  %s\n' "$release_sha256" "$archive" | sha256sum -c - >/dev/null 2>&1; then
        notice "  -> Downloading RomRaider2 1.1.10"
        if [[ "$quiet" == 1 ]]; then
            curl --fail --location --silent --show-error \
                --output "$archive" "$release_url"
        else
            curl --fail --location --progress-bar --output "$archive" "$release_url"
        fi
    fi
    printf '%s  %s\n' "$release_sha256" "$archive" | sha256sum -c - >/dev/null
    unzip -q "$archive" -d "$stage"
fi
staged_root=$stage/$archive_root
modern_install "$staged_root" || {
    echo "The verified RomRaider2 archive is not a complete Java 21 application image." >&2
    exit 1
}
[[ ! -L "$staged_root/config" ]] || {
    echo 'Package configuration root must not be a symbolic link.' >&2
    exit 1
}

# Prefer one complete source, never merge stale legacy files into a current
# installation. Non-migrated locations remain in the untouched predecessor or
# the complete current-installation backup, rather than being silently deleted.
migration_source=
if [[ -d "$install_root" ]]; then
    migration_source=$install_root
else
    for legacy_install_root in "${legacy_install_roots[@]}"; do
        if [[ -d "$legacy_install_root" ]]; then
            migration_source=$legacy_install_root
            break
        fi
    done
fi
copy_user_content() {
    local source=$1 user_dir
    [[ ! -L "$source" && ! -L "$source/config" ]] || {
        echo 'Symlinked migration roots require manual migration; the original is unchanged.' >&2
        return 1
    }
    # These are data-only paths. Do not copy old bin/lib/customize/default files
    # over the new executable, runtime, drivers, or packaged defaults.
    for user_dir in config/user definitions profiles logs roms repositories; do
        if [[ -e "$source/$user_dir" || -L "$source/$user_dir" ]]; then
            [[ -d "$source/$user_dir" && ! -L "$source/$user_dir" && \
                ! -L "$staged_root/$user_dir" ]] || {
                echo "Cannot safely migrate $user_dir; the original is unchanged." >&2
                return 1
            }
            # A packaged destination link must never redirect migration writes.
            if [[ -d "$staged_root/$user_dir" ]] && \
                    [[ -n "$(find "$staged_root/$user_dir" -type l -print -quit)" ]]; then
                echo "Package contains a linked migration destination: $user_dir" >&2
                return 1
            fi
            mkdir -p "$staged_root/$user_dir"
            cp -a -- "$source/$user_dir/." "$staged_root/$user_dir/"
        fi
    done
}
if [[ -n "$migration_source" ]]; then
    copy_user_content "$migration_source"
fi
mkdir -p "$staged_root/config/user"
[[ ! -L "$staged_root/config/user/settings.xml" ]] || {
    echo 'Symlinked settings require manual migration; the original is unchanged.' >&2
    exit 1
}
if [[ ! -f "$staged_root/config/user/settings.xml" ]]; then
    cp -- "$staged_root/config/settings.default.xml" "$staged_root/config/user/settings.xml"
fi
# Existing settings are user-owned: retain their exact contents and paths.
# Clean packaged defaults already contain no private vehicle references.

: >"$staged_root/.installed-by-subaru-ecu-tools"
printf '%s\n' "$release_sha256" >"$staged_root/.release-sha256"
if [[ -e "$install_root" ]]; then
    backup=${install_root}.backup-$(date +%Y%m%d-%H%M%S)
    [[ ! -e "$backup" ]] || backup=$backup-$$
    notice "  -> Preserving the previous RomRaider2 installation at $backup"
    mv -- "$install_root" "$backup"
fi
mv -- "$staged_root" "$install_root"
installation_committed=true
rmdir -- "$stage"
trap - EXIT HUP INT TERM
for legacy_install_root in "${legacy_install_roots[@]}"; do
    if [[ "$legacy_install_root" != "$install_root" && \
          -d "$legacy_install_root" ]]; then
        notice "  -> Retained predecessor unchanged at $legacy_install_root (including any unmigrated custom files)."
    fi
done
notice "  OK RomRaider2 1.1.10 installed at $install_root"
