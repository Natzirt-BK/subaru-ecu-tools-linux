#!/bin/sh
set -eu

: "${XDG_DATA_HOME:=$HOME/.local/share}"
if [ -z "${ROMRAIDER_HOME:-}" ]; then
    if [ -f "$XDG_DATA_HOME/romraider-dm20/RomRaider.jar" ]; then
        ROMRAIDER_HOME="$XDG_DATA_HOME/romraider-dm20"
    else
        ROMRAIDER_HOME="$XDG_DATA_HOME/romraider"
    fi
fi
: "${ROMRAIDER_JAVA:=$ROMRAIDER_HOME/jre32/bin/java}"
: "${ROMRAIDER_MODE:=editor}"

if [ ! -f "$ROMRAIDER_HOME/RomRaider.jar" ]; then
    echo "RomRaider DimeMod was not found in $ROMRAIDER_HOME" >&2
    echo "Install its Linux ZIP there or set ROMRAIDER_HOME." >&2
    exit 1
fi
if [ ! -x "$ROMRAIDER_JAVA" ]; then
    echo "The bundled 32-bit Java runtime was not found: $ROMRAIDER_JAVA" >&2
    echo "Use the complete DimeMod Linux package or set ROMRAIDER_JAVA." >&2
    exit 1
fi

case "$ROMRAIDER_MODE" in
    editor) ;;
    logger) set -- -logger "$@" ;;
    *) echo "ROMRAIDER_MODE must be 'editor' or 'logger'." >&2; exit 2 ;;
esac

mkdir -p "$HOME/.RomRaider"
cd "$ROMRAIDER_HOME"
exec "$ROMRAIDER_JAVA" \
    -Djava.library.path=lib/linux/32 \
    -Dawt.useSystemAAFontSettings=lcd \
    -Dswing.aatext=true \
    -Dsun.java2d.d3d=false \
    -Xms64M -Xmx512M \
    -XX:-UseParallelGC \
    -XX:CompileThreshold=10000 \
    -jar RomRaider.jar "$@" \
    >> "$HOME/.RomRaider/romraider_sout.log" 2>&1
