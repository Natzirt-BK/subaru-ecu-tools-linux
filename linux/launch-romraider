#!/bin/sh
set -eu

: "${XDG_DATA_HOME:=$HOME/.local/share}"
if [ -z "${ROMRAIDER_HOME:-}" ]; then
    if [ -f "$XDG_DATA_HOME/romraider-dm20/RomRaider.jar" ]; then
        ROMRAIDER_HOME="$XDG_DATA_HOME/romraider-dm20"
    else
        ROMRAIDER_HOME="$XDG_DATA_HOME/romraider"
    fi
fi
: "${ROMRAIDER_JAVA:=$ROMRAIDER_HOME/jre32/bin/java}"
: "${ROMRAIDER_MODE:=editor}"
current_user=${USER:-$(id -un)}
: "${OPENPORT_USB_SYSFS_ROOT:=/sys/bus/usb/devices}"
: "${OPENPORT_USB_DEV_ROOT:=/dev/bus/usb}"

report_error() {
    printf '%s\n' "$1" >&2
    if command -v kdialog >/dev/null 2>&1 && \
       { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        kdialog --title "RomRaider $ROMRAIDER_MODE could not start" --error "$1" || true
    fi
}

openport_raw_access_state() {
    openport_found=false
    for vendor_file in "$OPENPORT_USB_SYSFS_ROOT"/*/idVendor; do
        [ -f "$vendor_file" ] || continue
        [ "$(tr '[:upper:]' '[:lower:]' <"$vendor_file")" = 0403 ] || continue
        device_dir=${vendor_file%/idVendor}
        [ -f "$device_dir/idProduct" ] || continue
        [ "$(tr '[:upper:]' '[:lower:]' <"$device_dir/idProduct")" = cc4d ] || continue
        openport_found=true
        read -r busnum <"$device_dir/busnum" || continue
        read -r devnum <"$device_dir/devnum" || continue
        case "$busnum:$devnum" in
            *[!0-9:]*|:|*:|*:*:*) continue ;;
        esac
        node=$(printf '%s/%03d/%03d' "$OPENPORT_USB_DEV_ROOT" "$busnum" "$devnum")
        [ -r "$node" ] && [ -w "$node" ] && return 0
    done
    $openport_found && return 1
    return 2
}

if openport_raw_access_state; then
    openport_access_state=accessible
else
    case $? in
        1) openport_access_state=inaccessible ;;
        *) openport_access_state=disconnected ;;
    esac
fi

if [ "$ROMRAIDER_MODE" = logger ] && \
   [ "$openport_access_state" = inaccessible ] && \
   ! id -nG | tr ' ' '\n' | grep -qx uucp; then
    if getent group uucp | cut -d: -f4 | tr ',' '\n' | grep -qx "$current_user"; then
        if [ "${ROMRAIDER_GROUP_REFRESHED:-0}" = 1 ]; then
            report_error "The Logger could not activate the uucp device-access group. Log out and back in, then try again."
            exit 1
        fi
        /usr/bin/newgrp uucp -c \
            "env ROMRAIDER_MODE=logger ROMRAIDER_GROUP_REFRESHED=1 '$0'" || {
            report_error "The Logger could not activate the uucp device-access group. Log out and back in, then try again."
            exit 1
        }
        exit 0
    fi
    report_error "The connected OpenPort is not readable/writable. Desktop uaccess did not grant access and your account is not in the uucp fallback group. Run Subaru & Evo ECU Tools Setup with USB permissions selected, then reconnect it."
    exit 1
fi
if [ "$ROMRAIDER_MODE" = logger ] && \
   [ "$openport_access_state" = inaccessible ]; then
    report_error "The connected OpenPort is not readable/writable even though the uucp fallback group is active. Check its udev rule and reconnect it."
    exit 1
fi

if [ ! -f "$ROMRAIDER_HOME/RomRaider.jar" ]; then
    report_error "RomRaider DimeMod was not found in $ROMRAIDER_HOME. Install its complete Linux ZIP there or set ROMRAIDER_HOME."
    exit 1
fi
if [ ! -x "$ROMRAIDER_JAVA" ]; then
    report_error "The bundled 32-bit Java runtime was not found: $ROMRAIDER_JAVA. Use the complete DimeMod Linux package or set ROMRAIDER_JAVA."
    exit 1
fi
injector_bundle_root="$ROMRAIDER_HOME/i18n/com/romraider/logger/ecu/ui/tab"
if [ -d "$injector_bundle_root/Injector" ] && [ ! -e "$injector_bundle_root/injector" ]; then
    mv -- "$injector_bundle_root/Injector" "$injector_bundle_root/injector" || {
        report_error "The DimeMod Logger language-bundle case mismatch could not be repaired in $injector_bundle_root."
        exit 1
    }
fi
required_bundle="$ROMRAIDER_HOME/i18n/com/romraider/logger/ecu/ui/tab/injector/InjectorTabImpl.properties"
if [ ! -f "$required_bundle" ]; then
    report_error "The RomRaider DimeMod language resources are incomplete: $required_bundle. Re-run Subaru & Evo ECU Tools Setup and select RomRaider DimeMod."
    exit 1
fi

definition_configurator="${XDG_BIN_HOME:-$HOME/.local/bin}/configure-romraider-definitions"
if [ -x "$definition_configurator" ]; then
    "$definition_configurator" || {
        report_error "Installed RomRaider definitions could not be configured. Run Subaru & Evo ECU Tools Setup again."
        exit 1
    }
fi

case "$ROMRAIDER_MODE" in
    editor) ;;
    logger) set -- -logger "$@" ;;
    *) echo "ROMRAIDER_MODE must be 'editor' or 'logger'." >&2; exit 2 ;;
esac

mkdir -p "$HOME/.RomRaider"
romraider_log="$HOME/.RomRaider/romraider_sout.log"
if [ -f "$romraider_log" ] && [ "$(wc -c <"$romraider_log")" -gt 10485760 ]; then
    mv -f -- "$romraider_log" "$romraider_log.previous"
fi
cd "$ROMRAIDER_HOME"
LD_LIBRARY_PATH="/usr/lib32${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
set +e
"$ROMRAIDER_JAVA" \
    -Djava.library.path=lib/linux/32 \
    -Dawt.useSystemAAFontSettings=lcd \
    -Dswing.aatext=true \
    -Dsun.java2d.d3d=false \
    -Xms64M -Xmx512M \
    -XX:-UseParallelGC \
    -XX:CompileThreshold=10000 \
    -jar RomRaider.jar "$@" \
    >> "$romraider_log" 2>&1
java_status=$?
set -e
# A new RomRaider profile is written on first exit. Configure definitions then
# as well so every later launch is ready without manual Definition Manager work.
if [ -x "$definition_configurator" ]; then
    "$definition_configurator" || true
fi
if [ "$java_status" -ne 0 ]; then
    report_error "RomRaider $ROMRAIDER_MODE exited with status $java_status. Diagnostic log: $romraider_log"
fi
exit "$java_status"
