#!/bin/sh
set -eu

: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${ROMRAIDER2_HOME:=$XDG_DATA_HOME/romraider2-ecu-studio}"
: "${ROMRAIDER2_MODE:=editor}"
: "${OPENPORT_USB_SYSFS_ROOT:=/sys/bus/usb/devices}"
: "${OPENPORT_USB_DEV_ROOT:=/dev/bus/usb}"

report_error() {
    printf '%s\n' "$1" >&2
    if command -v kdialog >/dev/null 2>&1 && \
       { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        kdialog --title "RomRaider2 could not start" --error "$1" || true
    fi
}

openport_accessible_or_absent() {
    found=false
    for vendor_file in "$OPENPORT_USB_SYSFS_ROOT"/*/idVendor; do
        [ -f "$vendor_file" ] || continue
        [ "$(tr '[:upper:]' '[:lower:]' <"$vendor_file")" = 0403 ] || continue
        device_dir=${vendor_file%/idVendor}
        [ -f "$device_dir/idProduct" ] || continue
        [ "$(tr '[:upper:]' '[:lower:]' <"$device_dir/idProduct")" = cc4d ] || continue
        found=true
        read -r busnum <"$device_dir/busnum" || continue
        read -r devnum <"$device_dir/devnum" || continue
        case "$busnum:$devnum" in *[!0-9:]*|:|*:|*:*:*) continue ;; esac
        node=$(printf '%s/%03d/%03d' "$OPENPORT_USB_DEV_ROOT" "$busnum" "$devnum")
        [ -r "$node" ] && [ -w "$node" ] && return 0
    done
    ! $found
}

if [ ! -f "$ROMRAIDER2_HOME/.installed-by-subaru-ecu-tools" ]; then
    report_error "RomRaider2 is not installed. Open Ecu Tools Setup from the Ecu Tools by NatZirt menu and select RomRaider2."
    exit 1
fi
if [ "$ROMRAIDER2_MODE" = logger ] && ! openport_accessible_or_absent; then
    report_error "The connected OpenPort is not readable and writable. Open Setup, repair USB permissions, then reconnect it."
    exit 1
fi

case "$ROMRAIDER2_MODE" in
    logger) mode_argument=-logger ;;
    editor) mode_argument= ;;
    *) report_error "ROMRAIDER2_MODE must be logger or editor."; exit 2 ;;
esac

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/subaru-ecu-tools-linux
mkdir -p "$state_dir"
log=$state_dir/romraider2-launch.log
set +e
if [ -x "$ROMRAIDER2_HOME/bin/RomRaider2" ] && \
   [ -f "$ROMRAIDER2_HOME/lib/runtime/release" ]; then
    cd "$ROMRAIDER2_HOME" || exit 1
    "$ROMRAIDER2_HOME/bin/RomRaider2" \
        $mode_argument >>"$log" 2>&1
else
    case "$ROMRAIDER2_MODE" in
        logger) launcher=$ROMRAIDER2_HOME/START_LOGGER_LINUX.sh ;;
        editor) launcher=$ROMRAIDER2_HOME/START_EDITOR_LINUX.sh ;;
    esac
    if [ ! -x "$launcher" ]; then
        report_error "The RomRaider2 launcher is missing. Reinstall the optional component."
        exit 1
    fi
    "$launcher" >>"$log" 2>&1
fi
status=$?
set -e
if [ "$status" -ne 0 ]; then
    report_error "RomRaider2 exited with status $status. Diagnostic log: $log"
fi
exit "$status"
