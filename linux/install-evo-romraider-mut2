#!/usr/bin/env bash
set -euo pipefail

data_root=${XDG_DATA_HOME:-$HOME/.local/share}
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/subaru-ecu-tools-linux
install_root=${EVO_MUT2_INSTALL_ROOT:-$data_root/romraider-mut2-evo-88780008}
archive=${EVO_MUT2_ARCHIVE:-$cache_root/RomRaider_MUT2_88780008_Release_v1.0.1.zip}
archive_root=RomRaider_MUT2_88780008_Release_v1.0.1
release_url=${EVO_MUT2_URL:-https://github.com/Natzirt-BK/subaru-ecu-tools-linux/releases/download/romraider-mut2-evo-88780008-v1.0.1/RomRaider_MUT2_88780008_Release_v1.0.1.zip}
release_sha256=${EVO_MUT2_SHA256:-27a026afbe25d0759c15d29daa27b7003e9e4de903dde8507aa920457f4c005f}
source_root=${EVO_MUT2_SOURCE_ROOT:-}

case "$install_root" in
    ''|/|"$HOME") echo "Unsafe Evo RomRaider install path: $install_root" >&2; exit 2 ;;
esac

complete_install() {
    local root=$1
    [[ -x "$root/START_LOGGER_LINUX.sh" && \
       -x "$root/START_EDITOR_LINUX.sh" && \
       -x "$root/app/jre32/bin/java" && \
       -f "$root/app/RomRaider-MUT2-88780008-32.jar" && \
       -f "$root/app/lib/linux/32/j2534.so" && \
       -f "$root/app/i18n/com/romraider/ECUExec.properties" && \
       -f "$root/definitions/RomRaider_Logger/88780008_MUT2_logger.xml" && \
       -f "$root/definitions/RomRaider_Profiles/88780008_MUT2_Tuning_Profile.xml" ]]
}

if complete_install "$install_root" && \
   [[ -f "$install_root/.installed-by-subaru-ecu-tools" ]] && \
   [[ -f "$install_root/.release-sha256" ]] && \
   grep -Fxq "$release_sha256" "$install_root/.release-sha256"; then
    echo "  OK Optional Evo MUT-Raider-II is already current."
    exit 0
fi

mkdir -p "$cache_root" "$(dirname -- "$install_root")"
stage=$(mktemp -d "$(dirname -- "$install_root")/.romraider-evo-mut2-install.XXXXXX")
trap 'rm -rf -- "$stage"' EXIT HUP INT TERM
if [[ -n "$source_root" ]]; then
    [[ -d "$source_root" ]] || {
        echo "EVO_MUT2_SOURCE_ROOT is not a directory: $source_root" >&2
        exit 2
    }
    cp -a -- "$source_root" "$stage/$archive_root"
else
    if [[ ! -f "$archive" ]] || \
       ! printf '%s  %s\n' "$release_sha256" "$archive" | sha256sum -c - >/dev/null 2>&1; then
        echo "  -> Downloading optional Evo MUT-Raider-II 88780008 release"
        curl --fail --location --progress-bar --output "$archive" "$release_url"
    fi
    printf '%s  %s\n' "$release_sha256" "$archive" | sha256sum -c - >/dev/null
    unzip -q "$archive" -d "$stage"
fi
staged_root=$stage/$archive_root
complete_install "$staged_root" || {
    echo "The verified Evo RomRaider archive is incomplete after extraction." >&2
    exit 1
}

: >"$staged_root/.installed-by-subaru-ecu-tools"
printf '%s\n' "$release_sha256" >"$staged_root/.release-sha256"
if [[ -e "$install_root" ]]; then
    backup=${install_root}.backup-$(date +%Y%m%d-%H%M%S)
    [[ ! -e "$backup" ]] || backup=$backup-$$
    echo "  -> Preserving the previous Evo RomRaider installation at $backup"
    mv -- "$install_root" "$backup"
fi
mv -- "$staged_root" "$install_root"
rmdir -- "$stage"
trap - EXIT HUP INT TERM
echo "  OK Optional Evo MUT-Raider-II installed at $install_root"
