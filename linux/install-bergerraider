#!/usr/bin/env bash
set -euo pipefail

data_root=${XDG_DATA_HOME:-$HOME/.local/share}
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/subaru-ecu-tools-linux
install_root=${BERGERRAIDER_INSTALL_ROOT:-$data_root/bergerraider-ecu-studio}
legacy_install_root=${BERGERRAIDER_LEGACY_INSTALL_ROOT:-$data_root/bergerraider-ecu-studio-preview-1}
archive=${BERGERRAIDER_ARCHIVE:-$cache_root/BergerRaider_ECU_Studio_1.1.0_Linux_x64.zip}
archive_root=BergerRaider_ECU_Studio_1.1.0_Linux_x64
release_url=${BERGERRAIDER_URL:-https://github.com/Natzirt-BK/subaru-ecu-tools-linux/releases/download/bergerraider-1.1.0-rc1/BergerRaider_ECU_Studio_1.1.0_Linux_x64.zip}
release_sha256=${BERGERRAIDER_SHA256:-bca8d6260804bf1a5c9532d290d634628ae16bb45a721d03860debb771a21223}
source_root=${BERGERRAIDER_SOURCE_ROOT:-}

case "$install_root" in
    ''|/|"$HOME") echo "Unsafe BergerRaider install path: $install_root" >&2; exit 2 ;;
esac

modern_install() {
    local root=$1
    [[ -x "$root/bin/BergerRaider" && \
       -f "$root/lib/runtime/release" && \
       -f "$root/lib/app/BergerRaider.jar" && \
       -f "$root/lib/app/BergerRaider.cfg" && \
       -f "$root/lib/app/lib/linux/64/j2534.so" && \
       -f "$root/config/settings.foz.xml" && \
       -f "$root/customize/j2534Libraries.properties" && \
       -f "$root/definitions/Evo/88780008_MUT2_logger.xml" && \
       -f "$root/definitions/Evo/release/EcuFlash/88780008_Final_v6.xml" && \
       -f "$root/definitions/Evo/release/EcuFlash/evo9base.xml" && \
       -f "$root/definitions/Evo/release/RomRaider/88780008_RomRaider_Final_v4.xml" && \
       -f "$root/definitions/Foz/Editor/Z2WC412I_DM23100_RR.xml" && \
       -f "$root/definitions/Foz/Logger/logger_METRIC_EN_v370.xml" && \
       -f "$root/definitions/Foz/Profiles/shinji.xml" ]] && \
        grep -Fq 'bergerraider.settings.dir=$APPDIR/../../config/user' \
            "$root/lib/app/BergerRaider.cfg" && \
        grep -Fq '<protocol name="SSM" transport="ISO9141"' \
            "$root/config/settings.foz.xml" && \
        grep -Fq '<profile path="definitions/Foz/Profiles/shinji.xml"/>' \
            "$root/config/settings.foz.xml" && \
        grep -Fq 'linux=j2534.so' \
            "$root/customize/j2534Libraries.properties"
}

migrate_obsolete_foz_logger_defaults() {
    local settings=$1
    grep -Eq '<protocol name="OBD" transport="(ISO15765|ISO9141)" module="ECU"' \
        "$settings" || return 0
    grep -Fq '<profile path="definitions/Foz/Profiles/aem-uego-9600.xml"/>' \
        "$settings" || return 0
    sed -Ei \
        -e 's#<serial port="ttyS0" refresh="true"/>#<serial port="" refresh="true"/>#' \
        -e 's#<protocol name="OBD" transport="(ISO15765|ISO9141)" module="ECU" fastpoll="false" library="[^"]*"/>#<protocol name="SSM" transport="ISO9141" module="ECU" fastpoll="false" library=""/>#' \
        -e 's#<profile path="definitions/Foz/Profiles/aem-uego-9600.xml"/>#<profile path="definitions/Foz/Profiles/shinji.xml"/>#' \
        "$settings"
    echo "  -> Migrated the obsolete Forester OBD logger default to SSM/ISO9141."
}

if modern_install "$install_root" && \
   [[ -f "$install_root/.installed-by-subaru-ecu-tools" ]] && \
   [[ -f "$install_root/.release-sha256" ]] && \
   grep -Fxq "$release_sha256" "$install_root/.release-sha256"; then
    echo "  OK BergerRaider 1.1.0 release candidate is already current."
    exit 0
fi

mkdir -p "$cache_root" "$(dirname -- "$install_root")"
stage=$(mktemp -d "$(dirname -- "$install_root")/.bergerraider-install.XXXXXX")
trap 'rm -rf -- "$stage"' EXIT HUP INT TERM
if [[ -n "$source_root" ]]; then
    [[ -d "$source_root" ]] || {
        echo "BERGERRAIDER_SOURCE_ROOT is not a directory: $source_root" >&2
        exit 2
    }
    cp -a -- "$source_root" "$stage/$archive_root"
else
    if [[ ! -f "$archive" ]] || \
       ! printf '%s  %s\n' "$release_sha256" "$archive" | sha256sum -c - >/dev/null 2>&1; then
        echo "  -> Downloading BergerRaider 1.1.0 release candidate"
        curl --fail --location --progress-bar --output "$archive" "$release_url"
    fi
    printf '%s  %s\n' "$release_sha256" "$archive" | sha256sum -c - >/dev/null
    unzip -q "$archive" -d "$stage"
fi
staged_root=$stage/$archive_root
modern_install "$staged_root" || {
    echo "The verified BergerRaider archive is not a complete Java 21 application image." >&2
    exit 1
}

mkdir -p "$staged_root/config/user"
if [[ -f "$install_root/config/user/settings.xml" ]]; then
    cp -- "$install_root/config/user/settings.xml" \
        "$staged_root/config/user/settings.xml"
elif [[ -f "$legacy_install_root/config/user/settings.xml" ]]; then
    cp -- "$legacy_install_root/config/user/settings.xml" \
        "$staged_root/config/user/settings.xml"
else
    cp -- "$staged_root/config/settings.foz.xml" \
        "$staged_root/config/user/settings.xml"
fi
migrate_obsolete_foz_logger_defaults "$staged_root/config/user/settings.xml"
if [[ -d "$install_root" ]]; then
    for user_dir in logs roms repositories; do
        if [[ -d "$install_root/$user_dir" ]]; then
            mkdir -p "$staged_root/$user_dir"
            cp -a -- "$install_root/$user_dir/." "$staged_root/$user_dir/"
        fi
    done
fi

: >"$staged_root/.installed-by-subaru-ecu-tools"
printf '%s\n' "$release_sha256" >"$staged_root/.release-sha256"
if [[ -e "$install_root" ]]; then
    backup=${install_root}.backup-$(date +%Y%m%d-%H%M%S)
    [[ ! -e "$backup" ]] || backup=$backup-$$
    echo "  -> Preserving the previous BergerRaider installation at $backup"
    mv -- "$install_root" "$backup"
fi
mv -- "$staged_root" "$install_root"
rmdir -- "$stage"
trap - EXIT HUP INT TERM
if [[ "$legacy_install_root" != "$install_root" && \
      -f "$legacy_install_root/.installed-by-subaru-ecu-tools" ]]; then
    for user_dir in logs roms repositories; do
        if [[ -d "$legacy_install_root/$user_dir" ]]; then
            cp -a -- "$legacy_install_root/$user_dir/." "$install_root/$user_dir/"
        fi
    done
    rm -rf -- "$legacy_install_root"
    echo "  -> Removed the obsolete installer-managed foundation preview after migration."
fi
echo "  OK BergerRaider 1.1.0 release candidate installed at $install_root"
