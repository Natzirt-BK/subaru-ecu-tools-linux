#!/bin/sh
set -eu

command -v pw-play >/dev/null 2>&1 || exit 0
audio_pid=
cleanup() {
    trap - EXIT HUP INT TERM
    if [ -n "$audio_pid" ]; then
        kill "$audio_pid" >/dev/null 2>&1 || true
        wait "$audio_pid" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT HUP INT TERM

generate_loop() {
    LC_ALL=C awk 'BEGIN {
        rate = 11025
        step = 0.14
        split("76 79 83 88 83 79 74 79 81 84 88 91 88 84 72 76 79 84 79 76 71 74 79 83 86 83 79 74 76 79 83 88", melody)
        split("40 40 43 43 45 45 35 35", bass)
        for (i = 1; i <= 32; i++) {
            mf = 440 * exp(log(2) * (melody[i] - 69) / 12)
            bf = 440 * exp(log(2) * (bass[1 + int((i - 1) / 4) % 8] - 69) / 12)
            count = int(rate * step)
            for (sample = 0; sample < count; sample++) {
                lead = (int(sample * mf * 2 / rate) % 2) ? 1 : -1
                low = (int(sample * bf * 2 / rate) % 2) ? 1 : -1
                tick = (i % 2 == 1 && sample < 90) ? (1 - sample / 90) : 0
                edge = sample < 80 ? sample / 80 : ((count - sample) < 100 ? (count - sample) / 100 : 1)
                value = int(128 + edge * (25 * lead + 13 * low) + 10 * tick)
                if (value < 0) value = 0
                if (value > 255) value = 255
                printf "%c", value
            }
        }
    }'
}

while :; do
    generate_loop | pw-play --raw --rate 11025 --channels 1 --format u8 \
        --volume 0.12 - >/dev/null 2>&1 &
    audio_pid=$!
    wait "$audio_pid" || exit 0
    audio_pid=
done
