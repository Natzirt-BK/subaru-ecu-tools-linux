#!/bin/sh
set -eu

# Override these in the environment when your installation differs.
: "${ECUFLASH_WINEPREFIX:=$HOME/.local/share/ecuflash-proton}"
: "${ECUFLASH_WINE:=wine}"
: "${ECUFLASH_DIR:=$ECUFLASH_WINEPREFIX/drive_c/Program Files (x86)/OpenECU/EcuFlash}"

: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${ECU_TOOLS_DATA_DIR:=$XDG_DATA_HOME/subaru-ecu-tools-linux}"
: "${ECUFLASH_WINEDLLPATH:=$ECU_TOOLS_DATA_DIR/winedll}"

export WINEPREFIX="$ECUFLASH_WINEPREFIX"
export WINEDLLPATH="$ECUFLASH_WINEDLLPATH${WINEDLLPATH:+:$WINEDLLPATH}"

cd "$ECUFLASH_DIR"
exec "$ECUFLASH_WINE" ecuflash.exe "$@"
